# ===============================================
# Visual X - C语言代码静态分析平台 - 环境变量配置示例
# ===============================================

# =================== 必需配置 ===================

# Gemini API配置（必需）
GEMINI_API_KEY=your_gemini_api_key_here
# 可选：指定Gemini模型版本
GEMINI_MODEL=gemini-2.5-flash
# 可选：Gemini代理配置（如果需要代理访问）
GEMINI_PROXY_HOST=192.168.93.1
GEMINI_PROXY_PORT=7890

# =================== 路径配置 ===================

# C项目源码路径（主机路径，将挂载到容器）
PROJECT_SOURCE_PATH=/home/zwy/visual-x/projects
# 数据库存储路径（主机路径）
DATABASE_STORAGE_PATH=/home/zwy/visual-x/data
# 日志存储路径（主机路径）
LOG_PATH=/home/zwy/visual-x/logs
# 配置文件路径（主机路径，可选）
CONFIG_PATH=/home/zwy/visual-x/config

# 可选：指定特定的数据库文件
# DATABASE_FILE=/app/data/my_analysis.db

# =================== 服务配置 ===================

# 后端API端口（默认5002）
BACKEND_PORT=5002
# 前端界面端口（默认5001）
FRONTEND_PORT=5001

# =================== 环境配置 ===================

# 开发模式（true/false）
DEBUG=false
# Flask环境（development/production）
FLASK_ENV=production
# Python环境
PYTHONUNBUFFERED=1

# =================== 容器资源限制 ===================

# 内存限制（可选）
MEMORY_LIMIT=4g
# CPU限制（可选）
CPUS_LIMIT=2.0

# ===============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写您的 GEMINI_API_KEY
# 3. 根据需要调整其他配置
# 4. 运行 docker-compose up -d
# ===============================================